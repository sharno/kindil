// kindil · قنديل — one window for the dashboard, library, reader and settings.
//
// Designed for a 758×1024, 16-level e-ink panel driven by touch:
// - black on white, a few solid grays, no animation or translucency (each frame
//   costs a panel update, and dithered grays look dirty);
// - every tap target is at least 64 px tall, row targets span the full width;
// - the prayer dashboard stays full-bleed: tap it to reveal the status row, quick panel and tab bar.
import { VirtualKeyboard, VirtualKeyboardHandler } from "vendor/slint-keyboard/virtual_keyboard.slint";
export { VirtualKeyboardHandler }
import "../crates/miqat/assets/fonts/IBMPlexSansArabic-Regular.ttf";
import "../crates/miqat/assets/fonts/IBMPlexSansArabic-SemiBold.ttf";
import "../crates/miqat/assets/fonts/IBMPlexSansArabic-Bold.ttf";

/// Settings is an index; display through about are its sections.
export enum Page { dashboard, library, reader, settings, display, wifi, remote, power, updates, about, networks }
export enum DashboardKind { miqat, clock }
/// A setting's switch. `unavailable` covers "not installed" and "no hardware".
export enum Switch { off, on, unavailable }
/// What owns the screen: the app, or one of the device states kindil runs
/// in Amazon's place.
/// Whether content is moving under a finger.
export enum Motion { still, moving }

export enum System { app, asleep, usb-drive, off }

export struct BookItem {
    title: string,
    format: string,
    detail: string,
    progress: float,
    /// The file name on disk, for rename.
    file: string,
}

export struct NetworkItem {
    ssid: string,
    detail: string,
    bars: int,
}

export struct Fact {
    label: string,
    value: string,
}

global Theme {
    out property <color> ink: #000000;
    out property <color> ink-2: #333333;
    out property <color> ink-3: #4d4d4d;
    /// Disabled text: still above the 50% black/white threshold of fast motion mode.
    out property <color> dim: #707070;
    out property <color> line: #c0c0c0;
    out property <color> surface: #ececec;
    out property <color> paper: #ffffff;
    out property <length> gutter: 28px;
    out property <length> touch: 68px;
    out property <length> radius: 14px;
}

/// Everything the Rust side reads, writes and handles. Components bind here
/// directly instead of threading dozens of properties through each page.
export global Kindil {
    in-out property <Page> page: Page.dashboard;
    /// The Settings index or one of the pages under it.
    out property <bool> in-settings: page == Page.settings || page == Page.display || page == Page.wifi
        || page == Page.remote || page == Page.power || page == Page.updates || page == Page.about
        || page == Page.networks;
    in-out property <DashboardKind> dashboard: DashboardKind.miqat;
    /// The status row and tab bar over the full-bleed dashboard; other pages always show them.
    in-out property <bool> chrome-visible: false;
    /// The quick panel (front light, text size) dropped down from the status row.
    in-out property <bool> panel-open: false;
    /// Bumped by every use of a panel control, to restart the hide timer.
    in-out property <int> activity: 0;

    // Status row
    in property <string> clock: "--:--";
    in property <string> date;
    in property <int> battery-level: -1;
    in property <string> battery-label: "—";
    /// Low enough that kindil sleeps until it is charged.
    in property <bool> battery-empty;
    in property <int> wifi-bars: -1;

    // Dashboard
    in property <image> miqat-frame;
    in property <string> miqat-error: "Starting the prayer dashboard…";

    // Library
    in property <[BookItem]> books;
    in property <string> books-root;
    in-out property <int> selected-book: -1;
    in-out property <string> new-name;

    // Reader
    in property <bool> has-book: false;
    in property <string> book-title;
    in property <string> book-text;
    in property <string> book-position;
    in property <float> book-progress;
    in property <int> font-size: 24;

    // Settings
    in property <int> brightness: -1;
    in property <Switch> wifi: Switch.unavailable;
    in property <string> wifi-detail;
    in property <Switch> ssh: Switch.unavailable;
    in property <Switch> ssh-at-boot: Switch.unavailable;
    in property <Switch> boot-start: Switch.unavailable;
    in property <string> boot-start-detail;
    in property <string> ssh-detail;
    in property <Switch> sync: Switch.unavailable;
    in property <string> sync-detail;
    in property <[Fact]> facts;
    in property <string> version;

    // Wi-Fi networks
    in property <[NetworkItem]> networks;
    in property <string> network-status;
    in property <bool> network-busy: false;
    in-out property <bool> join-open: false;
    in-out property <string> join-ssid;

    // A short message above the tab bar, optionally with Undo.
    in-out property <string> notice;
    in-out property <bool> notice-undo: false;

    callback navigated(Page);
    callback choose-dashboard(DashboardKind);
    callback open-book(int);
    callback rename-book(int, string);
    callback trash-book(int);
    callback undo();
    callback next-page();
    callback previous-page();
    callback font-larger();
    callback font-smaller();
    /// The front light level (0-100) the slider settled on.
    callback choose-brightness(int);
    callback clean-screen();
    callback toggle-wifi();
    callback scan-networks();
    callback join-network(string, string);
    callback toggle-ssh();
    callback toggle-ssh-at-boot();
    callback toggle-boot-start();
    callback toggle-sync();
    callback exit-app();
    in property <System> system: System.app;
    /// Device events are waiting on the Rust side.
    callback device-events();
    /// Content started or stopped moving under a finger.
    callback motion(Motion);
    /// The Updates row.
    in property <string> update-status;
    in property <string> update-button: "Check";
    in property <bool> update-enabled: true;
    callback update();
    callback restart();
    callback power-off();
    /// The battery draw measured over the last stretch of dozing; empty until one is.
    in property <string> doze-draw;
    /// Auto-sleep: the choices' labels and the chosen one's index (-1: none of them).
    in property <[string]> sleep-choices;
    in property <int> auto-sleep: 0;
    callback choose-auto-sleep(int);

    public function go(target: Page) {
        page = target;
        chrome-visible = false;
        panel-open = false;
        navigated(target);
    }
}

// ───────────────────────── primitives ─────────────────────────

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line;
}

component Caption inherits Text {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 1.2px;
    color: Theme.ink-3;
}

enum ButtonKind { primary, outline, quiet }

component Button {
    in property <string> text;
    in property <bool> enabled: true;
    in property <ButtonKind> kind: ButtonKind.outline;
    in property <length> font-size: 21px;
    callback clicked();
    min-height: Theme.touch;
    min-width: Theme.touch;
    preferred-width: label.preferred-width + 44px;

    Rectangle {
        border-radius: Theme.radius;
        background: root.kind == ButtonKind.primary
            ? (root.enabled ? (touch.pressed ? Theme.ink-2 : Theme.ink) : Theme.line)
            : (touch.pressed ? Theme.surface : transparent);
        border-width: root.kind == ButtonKind.outline ? 2px : 0px;
        border-color: root.enabled ? Theme.ink : Theme.line;
    }
    label := Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: 600;
        color: root.kind == ButtonKind.primary ? Theme.paper : (root.enabled ? Theme.ink : Theme.dim);
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component Toggle {
    in property <Switch> state;
    width: 80px;
    height: 44px;
    Rectangle {
        border-radius: self.height / 2;
        background: root.state == Switch.on ? Theme.ink : Theme.paper;
        border-width: 2px;
        border-color: root.state == Switch.unavailable ? Theme.line : Theme.ink;
        Rectangle {
            width: 32px;
            height: 32px;
            y: 6px;
            x: root.state == Switch.on ? parent.width - self.width - 6px : 6px;
            border-radius: self.height / 2;
            background: root.state == Switch.on ? Theme.paper : (root.state == Switch.unavailable ? Theme.line : Theme.ink);
        }
    }
}

/// A full-width row: title, optional detail line, and a switch. The whole row is the target.
component SwitchRow {
    in property <string> title;
    in property <string> detail;
    in property <Switch> state;
    callback toggled();
    min-height: 84px;
    HorizontalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: 23px;
                font-weight: 600;
                color: root.state == Switch.unavailable ? Theme.dim : Theme.ink;
            }
            if root.detail != "": Text {
                text: root.detail;
                font-size: 18px;
                color: Theme.ink-2;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            alignment: center;
            Toggle { state: root.state; }
        }
    }
    TouchArea {
        enabled: root.state != Switch.unavailable;
        clicked => { root.toggled(); }
    }
}

/// The front light as a slider. Tapping the track jumps the light there. While
/// the finger is down only the knob follows it (a small redraw); the light is
/// set about every 400 ms and once more on release, not on every movement.
component LightSlider {
    in property <int> value;
    /// The finger is on the slider.
    callback touched();
    callback chosen(int);
    property <bool> enabled: root.value >= 0;
    // Room for half the knob at each end of the track.
    property <length> pad: 28px;
    property <length> span: root.width - 2 * root.pad;
    // The level under the finger.
    property <int> at: round(clamp(touch.mouse-x - root.pad, 0px, root.span) / root.span * 100);
    property <int> shown: touch.pressed ? root.at : max(root.value, 0);
    min-width: 160px;
    horizontal-stretch: 1;
    // A thick track and a big knob, so it is plain on e-ink what is being slid.
    Rectangle {
        x: root.pad;
        y: (parent.height - self.height) / 2;
        width: root.span;
        height: 22px;
        border-radius: 11px;
        background: root.enabled ? Theme.line : Theme.surface;
    }
    Rectangle {
        x: root.pad;
        y: (parent.height - self.height) / 2;
        width: root.span * root.shown / 100;
        height: 22px;
        border-radius: 11px;
        background: root.enabled ? Theme.ink : Theme.line;
    }
    Rectangle {
        x: root.pad + root.span * root.shown / 100 - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 48px;
        height: 48px;
        border-radius: 24px;
        border-width: 5px;
        border-color: root.enabled ? Theme.ink : Theme.line;
        background: touch.pressed ? Theme.ink : Theme.paper;
    }
    touch := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            root.touched();
            if event.kind == PointerEventKind.up && root.at != root.value {
                root.chosen(root.at);
            }
        }
    }
    Timer {
        interval: 400ms;
        running: touch.pressed;
        triggered => {
            if root.at != root.value {
                root.chosen(root.at);
            }
        }
    }
}

/// A sun for the ends of the light slider: a dim, small one and a bright, big one.
component Sun {
    in property <bool> bright;
    width: 44px;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: root.bright ? 22px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 3px;
        border-color: root.bright ? Theme.ink : Theme.ink-3;
        background: root.bright ? Theme.ink : transparent;
    }
    // Four rays: up, down, left, right.
    for ray[i] in 4: Rectangle {
        visible: root.bright;
        property <bool> vertical: mod(i, 2) == 0;
        width: self.vertical ? 3px : 8px;
        height: self.vertical ? 8px : 3px;
        x: root.width / 2 - self.width / 2 + (self.vertical ? 0px : (i == 1 ? 18px : -18px));
        y: root.height / 2 - self.height / 2 + (self.vertical ? (i == 0 ? -18px : 18px) : 0px);
        background: Theme.ink;
    }
}

/// The front light: dim sun, slider, bright sun, level. The same row in the
/// quick panel and in Settings.
component LightRow {
    callback touched();
    min-height: 88px;
    HorizontalLayout {
        spacing: 0px;
        Sun { }
        LightSlider {
            value: Kindil.brightness;
            touched => { root.touched(); }
            chosen(percent) => { Kindil.choose-brightness(percent); }
        }
        Sun { bright: true; }
        Text {
            text: Kindil.brightness >= 0 ? Kindil.brightness + "%" : "—";
            width: 70px;
            font-size: 23px;
            font-weight: 700;
            color: Kindil.brightness >= 0 ? Theme.ink : Theme.dim;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

component TextField {
    in-out property <string> text;
    in property <string> placeholder;
    in property <InputType> input-type: InputType.text;
    out property <bool> focused: input.has-focus;
    callback accepted();
    forward-focus: input;
    height: 68px;
    Rectangle {
        border-radius: 12px;
        border-width: input.has-focus ? 3px : 2px;
        border-color: Theme.ink;
        background: Theme.paper;
    }
    if root.text == "": Text {
        x: 20px;
        width: parent.width - 40px;
        height: parent.height;
        text: root.placeholder;
        font-size: 21px;
        color: Theme.ink-3;
        vertical-alignment: center;
    }
    input := TextInput {
        x: 20px;
        width: parent.width - 40px;
        height: parent.height;
        text <=> root.text;
        input-type: root.input-type;
        single-line: true;
        font-size: 22px;
        color: Theme.ink;
        vertical-alignment: center;
        accepted => { root.accepted(); }
    }
}

/// Wi-Fi strength as four bars; a single short gray bar when off.
component WifiBars {
    in property <int> bars;
    in property <color> color: Theme.ink;
    width: 30px;
    height: 22px;
    for i in 4: Rectangle {
        x: i * 8px;
        width: 6px;
        height: (i + 1) * 5px + 2px;
        y: parent.height - self.height;
        border-radius: 1px;
        background: i < root.bars ? root.color : Theme.line;
    }
}

component BatteryIcon {
    in property <int> level;
    width: 42px;
    height: 22px;
    Rectangle {
        x: 0;
        width: 38px;
        height: parent.height;
        border-radius: 5px;
        border-width: 2px;
        border-color: Theme.ink;
        Rectangle {
            x: 4px;
            y: 4px;
            height: parent.height - 8px;
            width: (parent.width - 8px) * clamp(root.level, 0, 100) / 100;
            border-radius: 2px;
            background: Theme.ink;
        }
    }
    Rectangle {
        x: 38px;
        y: 7px;
        width: 4px;
        height: 8px;
        border-radius: 1px;
        background: Theme.ink;
    }
}

component ProgressBar {
    in property <float> value;
    height: 6px;
    Rectangle {
        border-radius: 3px;
        background: Theme.surface;
    }
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: Theme.ink;
    }
}

/// A list moved by swiping, drawn for e-ink. The list follows the finger; while
/// it moves, the panel draws fast black-and-white frames one at a time, then
/// repaints the moved area in grayscale when the finger lifts.
component SwipeScroll inherits Rectangle {
    in property <length> content-height;
    in-out property <length> offset: 0;
    property <length> max-offset: max(0px, root.content-height - root.height);
    // Clamped here too, so a list that shrinks never shows empty space.
    property <length> shown: min(root.offset, root.max-offset);
    // Where the list sat when the finger went down.
    property <length> start;
    // Where the finger puts the list now.
    property <length> target: clamp(
        root.start + touch.pressed-position.y - touch.current-position.y,
        0px, root.max-offset);
    property <bool> dragging;
    clip: true;
    touch := SwipeGestureHandler {
        handle-swipe-up: root.shown < root.max-offset;
        handle-swipe-down: root.shown > 0;
        // The first movement of a swipe anchors it.
        moved => {
            if !root.dragging {
                root.start = root.shown;
                root.dragging = true;
                Kindil.motion(Motion.moving);
            }
            // The list follows the finger: the panel draws these frames in
            // fast black and white, one at a time, and cleans up on release.
            root.offset = root.target;
        }
        swiped => {
            root.offset = root.target;
            root.dragging = false;
            Kindil.motion(Motion.still);
        }
        cancelled => {
            root.offset = root.start;
            root.dragging = false;
            Kindil.motion(Motion.still);
        }
        Rectangle {
            y: -root.shown;
            height: root.content-height;
            @children
        }
    }
    // Where the view sits in the list. Darker and wider while the finger is down.
    if root.max-offset > 0: Rectangle {
        x: parent.width - (root.dragging ? 10px : 7px);
        y: 8px;
        width: root.dragging ? 7px : 4px;
        height: parent.height - 16px;
        border-radius: self.width / 2;
        background: Theme.surface;
        Rectangle {
            y: parent.height * root.shown / root.content-height;
            height: parent.height * root.height / root.content-height;
            border-radius: parent.border-radius;
            background: root.dragging ? Theme.ink : Theme.ink-2;
        }
    }
}

// ───────────────────────── chrome ─────────────────────────

/// A square outlined button for the top bar, sized for a thumb.
component BarButton {
    in property <string> text;
    in property <length> font-size: 26px;
    in property <bool> enabled: true;
    callback clicked();
    width: 56px;
    height: 56px;
    Rectangle {
        border-radius: Theme.radius;
        border-width: 2px;
        border-color: root.enabled ? Theme.ink : Theme.line;
        background: touch.pressed ? Theme.surface : Theme.paper;
    }
    Text {
        text: root.text;
        font-size: root.font-size;
        font-weight: 700;
        color: root.enabled ? Theme.ink : Theme.dim;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

/// The battery icon and percentage.
component BatteryStatus {
    // Its width is its content, so a layout leaves no gap before the next item.
    max-width: row.preferred-width;
    row := HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            BatteryIcon { level: Kindil.battery-level; }
        }
        Text {
            text: Kindil.battery-label;
            font-size: 19px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }
    }
}

/// Clock on the left, Wi-Fi and battery on the right. A tap drops the quick
/// panel down from it, or puts it away again.
component StatusRow inherits Rectangle {
    height: 56px;
    background: Theme.paper;
    HorizontalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        spacing: 10px;
        Text {
            text: Kindil.clock;
            font-size: 22px;
            font-weight: 700;
            color: Theme.ink;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if Kindil.wifi-bars >= 0: VerticalLayout {
            alignment: center;
            WifiBars { bars: Kindil.wifi-bars; }
        }
        Rectangle { width: 6px; }
        BatteryStatus { }
    }
    // A grip: the row can be pulled open.
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - 12px;
        width: 44px;
        height: 5px;
        border-radius: 2px;
        background: Kindil.panel-open ? Theme.ink : Theme.ink-3;
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
    TouchArea { clicked => { Kindil.panel-open = !Kindil.panel-open; } }
}

/// Quick settings under the status row. It covers the page rather than
/// pushing it down, so opening it redraws only its own area.
component QuickPanel inherits Rectangle {
    background: Theme.paper;
    height: self.preferred-height;
    preferred-height: column.preferred-height;
    // Swallow taps so they never reach the page underneath.
    TouchArea { }
    column := VerticalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        padding-top: 4px;
        padding-bottom: 14px;
        LightRow { touched => { Kindil.activity += 1; } }
        if Kindil.page == Page.reader: HorizontalLayout {
            height: 76px;
            spacing: 14px;
            Text {
                text: "Text size";
                font-size: 23px;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                BarButton {
                    text: "A";
                    font-size: 20px;
                    clicked => { Kindil.activity += 1; Kindil.font-smaller(); }
                }
            }
            Text {
                text: Kindil.font-size + " px";
                width: 84px;
                font-size: 23px;
                font-weight: 700;
                color: Theme.ink;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            VerticalLayout {
                alignment: center;
                BarButton {
                    text: "A";
                    font-size: 34px;
                    clicked => { Kindil.activity += 1; Kindil.font-larger(); }
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 3px;
        height: 3px;
        background: Theme.ink;
    }
}

component TabIcon {
    in property <Page> page;
    in property <color> color;
    width: 34px;
    height: 28px;
    if root.page == Page.dashboard: Rectangle {
        for i in 4: Rectangle {
            x: mod(i, 2) * 18px;
            y: floor(i / 2) * 15px;
            width: 15px;
            height: 12px;
            border-radius: 3px;
            border-width: 2px;
            border-color: root.color;
            background: i == 0 ? root.color : transparent;
        }
    }
    if root.page == Page.library: Rectangle {
        for i in 3: Rectangle {
            x: 3px + i * 10px;
            y: i == 1 ? 4px : 0px;
            width: 8px;
            height: parent.height - self.y;
            border-radius: 2px;
            background: root.color;
        }
    }
    if root.page == Page.reader: Rectangle {
        for i in 2: Rectangle {
            x: 2px + i * 15px;
            y: 2px;
            width: 15px;
            height: 24px;
            border-radius: 2px;
            border-width: 2px;
            border-color: root.color;
        }
    }
    if root.page == Page.settings: Rectangle {
        for i in 3: Rectangle {
            y: 3px + i * 10px;
            height: 2px;
            background: root.color;
            Rectangle {
                x: mod(i * 13px + 6px, 26px);
                y: -3px;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.color;
            }
        }
    }
}

component Tab {
    in property <Page> target;
    in property <string> label;
    in property <bool> enabled: true;
    property <bool> active: Kindil.page == root.target
        || (root.target == Page.settings && Kindil.in-settings);
    property <color> color: !root.enabled ? Theme.dim : (root.active ? Theme.ink : Theme.ink-3);
    horizontal-stretch: 1;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: 0;
        width: 64px;
        height: 5px;
        border-radius: 2px;
        background: root.active ? Theme.ink : transparent;
    }
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        HorizontalLayout {
            alignment: center;
            TabIcon { page: root.target; color: root.color; }
        }
        Text {
            text: root.label;
            font-size: 17px;
            font-weight: root.active ? 700 : (root.enabled ? 600 : 400);
            color: root.color;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { Kindil.go(root.target); }
    }
}

component TabBar inherits Rectangle {
    height: 92px;
    background: Theme.paper;
    Rectangle {
        y: 0;
        height: 2px;
        background: Theme.ink;
    }
    HorizontalLayout {
        Tab { target: Page.dashboard; label: "Home"; }
        Tab { target: Page.library; label: "Library"; }
        Tab { target: Page.reader; label: "Reading"; enabled: Kindil.has-book; }
        Tab { target: Page.settings; label: "Settings"; }
    }
}

component Notice inherits Rectangle {
    height: 72px;
    border-radius: Theme.radius;
    background: Theme.ink;
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: Kindil.notice;
            font-size: 20px;
            color: Theme.paper;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if Kindil.notice-undo: Rectangle {
            width: 110px;
            Text {
                text: "Undo";
                font-size: 21px;
                font-weight: 700;
                color: Theme.paper;
            }
            TouchArea { clicked => { Kindil.undo(); } }
        }
    }
}

component PageHeader {
    in property <string> title;
    in property <string> trailing;
    height: 96px;
    HorizontalLayout {
        padding-left: Theme.gutter;
        padding-right: Theme.gutter;
        padding-top: 16px;
        Text {
            text: root.title;
            font-size: 40px;
            font-weight: 700;
            color: Theme.ink;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.trailing;
            font-size: 19px;
            color: Theme.ink-3;
            vertical-alignment: center;
        }
    }
}

/// A sheet anchored to the bottom of the content area (above the keyboard).
component Sheet inherits Rectangle {
    background: Theme.paper;
    Rectangle {
        y: 0;
        height: 3px;
        background: Theme.ink;
    }
    // Swallow taps so they never reach the page underneath.
    TouchArea { }
    VerticalLayout {
        padding: Theme.gutter;
        padding-top: 28px;
        spacing: 16px;
        @children
    }
}

// ───────────────────────── pages ─────────────────────────

component ClockPage {
    VerticalLayout {
        alignment: center;
        spacing: 4px;
        Text {
            text: Kindil.clock;
            font-size: 190px;
            font-weight: 700;
            color: Theme.ink;
            horizontal-alignment: center;
        }
        Text {
            text: Kindil.date;
            font-size: 34px;
            color: Theme.ink-2;
            horizontal-alignment: center;
        }
    }
}

component BookRow {
    in property <BookItem> book;
    in property <int> index;
    height: 112px;
    TouchArea { clicked => { Kindil.open-book(root.index); } }
    HorizontalLayout {
        padding-left: Theme.gutter;
        spacing: 20px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 58px;
                height: 80px;
                border-radius: 6px;
                border-width: 2px;
                border-color: Theme.ink;
                Rectangle {
                    x: 8px;
                    y: 0;
                    width: 3px;
                    background: Theme.ink;
                }
                Text {
                    x: 14px;
                    width: parent.width - 16px;
                    text: root.book.format;
                    font-size: 13px;
                    font-weight: 700;
                    color: Theme.ink;
                    horizontal-alignment: center;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 6px;
            horizontal-stretch: 1;
            Text {
                text: root.book.title;
                font-size: 24px;
                font-weight: 600;
                color: Theme.ink;
                overflow: elide;
            }
            Text {
                text: root.book.detail;
                font-size: 18px;
                color: Theme.ink-2;
                overflow: elide;
            }
            // Wrapped: a fixed-width child would cap the whole column's width.
            if root.book.progress > 0: HorizontalLayout {
                alignment: start;
                ProgressBar {
                    width: 180px;
                    value: root.book.progress;
                }
            }
        }
        Rectangle {
            width: 84px;
            Text {
                text: "···";
                font-size: 30px;
                font-weight: 700;
                color: Theme.ink;
            }
            TouchArea {
                clicked => {
                    Kindil.selected-book = root.index;
                    Kindil.new-name = root.book.file;
                }
            }
        }
    }
    Divider {
        x: Theme.gutter;
        y: parent.height - 1px;
        width: parent.width - 2 * Theme.gutter;
    }
}

component LibraryPage {
    VerticalLayout {
        PageHeader {
            title: "Library";
            trailing: Kindil.books.length == 1 ? "1 book" : Kindil.books.length + " books";
        }
        if Kindil.books.length == 0: VerticalLayout {
            alignment: center;
            vertical-stretch: 1;
            spacing: 12px;
            padding: 48px;
            Text {
                text: "No books yet";
                font-size: 30px;
                font-weight: 600;
                color: Theme.ink;
                horizontal-alignment: center;
            }
            Text {
                text: "Copy .epub or .txt files into " + Kindil.books-root + " over USB or SSH.";
                font-size: 20px;
                color: Theme.ink-2;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
        if Kindil.books.length > 0: SwipeScroll {
            vertical-stretch: 1;
            content-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                alignment: start;
                for book[index] in Kindil.books: BookRow { book: book; index: index; }
            }
        }
    }
}

component BookActions inherits Sheet {
    property <bool> confirm-trash: false;
    property <string> current: Kindil.selected-book >= 0 && Kindil.selected-book < Kindil.books.length
        ? Kindil.books[Kindil.selected-book].title : "";
    Caption { text: "FILE"; }
    Text {
        text: root.current;
        font-size: 24px;
        font-weight: 600;
        color: Theme.ink;
        overflow: elide;
    }
    name := TextField {
        text <=> Kindil.new-name;
        placeholder: "New file name";
        accepted => { name-sink.focus(); }
    }
    HorizontalLayout {
        spacing: 12px;
        Button {
            text: root.confirm-trash ? "Tap again to trash" : "Move to Trash";
            horizontal-stretch: 1;
            clicked => {
                if root.confirm-trash {
                    Kindil.trash-book(Kindil.selected-book);
                    Kindil.selected-book = -1;
                } else {
                    root.confirm-trash = true;
                }
            }
        }
        Button {
            text: "Rename";
            kind: ButtonKind.primary;
            enabled: Kindil.new-name != "";
            horizontal-stretch: 1;
            clicked => {
                Kindil.rename-book(Kindil.selected-book, Kindil.new-name);
                Kindil.selected-book = -1;
                name-sink.focus();
            }
        }
    }
    Button {
        text: "Cancel";
        kind: ButtonKind.quiet;
        clicked => {
            Kindil.selected-book = -1;
            name-sink.focus();
        }
    }
    name-sink := FocusScope { height: 0px; }
}

component ReaderPage {
    VerticalLayout {
        HorizontalLayout {
            height: 68px;
            padding-left: 8px;
            padding-right: Theme.gutter;
            Button {
                text: "‹ Library";
                kind: ButtonKind.quiet;
                font-size: 19px;
                clicked => { Kindil.go(Page.library); }
            }
            Text {
                text: Kindil.book-title;
                font-size: 19px;
                font-weight: 600;
                color: Theme.ink-2;
                overflow: elide;
                horizontal-alignment: right;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
        // Sideways swipes turn pages, like the tap zones below.
        SwipeGestureHandler {
            vertical-stretch: 1;
            handle-swipe-left: true;
            handle-swipe-right: true;
            swiped => {
                if self.current-position.x < self.pressed-position.x {
                    Kindil.next-page();
                } else {
                    Kindil.previous-page();
                }
            }
        // Pagination plans conservatively; if a page still overflows, swipe up.
        pager := SwipeScroll {
            width: parent.width;
            height: parent.height;
            content-height: max(self.height, body.preferred-height + 40px);
            property <string> text: Kindil.book-text;
            changed text => { self.offset = 0; }
            // Classic e-reader zones: the left third goes back, the rest forward.
            TouchArea {
                clicked => {
                    if self.mouse-x < self.width / 3 {
                        Kindil.previous-page();
                    } else {
                        Kindil.next-page();
                    }
                }
            }
            body := Text {
                x: 44px;
                y: 16px;
                width: parent.width - 88px;
                text: Kindil.book-text;
                font-size: Kindil.font-size * 1px;
                line-height-factor: 1.0;
                color: Theme.ink;
                wrap: word-wrap;
                vertical-alignment: top;
            }
        }
        }
        HorizontalLayout {
            height: 76px;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 8px;
            Button {
                text: "‹ Prev";
                kind: ButtonKind.quiet;
                width: 140px;
                clicked => { Kindil.previous-page(); }
            }
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                horizontal-stretch: 1;
                ProgressBar { value: Kindil.book-progress; }
                Text {
                    text: Kindil.book-position;
                    font-size: 17px;
                    color: Theme.ink-2;
                    horizontal-alignment: center;
                }
            }
            Button {
                text: "Next ›";
                kind: ButtonKind.quiet;
                width: 140px;
                clicked => { Kindil.next-page(); }
            }
        }
    }
}

component Segment {
    in property <string> text;
    in property <bool> selected;
    callback clicked();
    horizontal-stretch: 1;
    Rectangle {
        border-radius: Theme.radius - 4px;
        background: root.selected ? Theme.ink : transparent;
    }
    Text {
        text: root.text;
        font-size: 20px;
        font-weight: 600;
        color: root.selected ? Theme.paper : Theme.ink;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component Group {
    /// Empty when the page title already names it.
    in property <string> title;
    VerticalLayout {
        padding-top: 22px;
        padding-bottom: 4px;
        spacing: 2px;
        if root.title != "": Caption { text: root.title; }
        @children
    }
}

enum PowerChoice { none, restart, power-off }

/// Restart and Power off, each confirmed by a second tap.
component PowerButtons inherits VerticalLayout {
    property <PowerChoice> asking: PowerChoice.none;
    if root.asking == PowerChoice.none: HorizontalLayout {
        spacing: 12px;
        Button {
            horizontal-stretch: 1;
            text: "Restart";
            clicked => { root.asking = PowerChoice.restart; }
        }
        Button {
            horizontal-stretch: 1;
            text: "Power off";
            clicked => { root.asking = PowerChoice.power-off; }
        }
    }
    if root.asking != PowerChoice.none: HorizontalLayout {
        spacing: 12px;
        Text {
            horizontal-stretch: 1;
            text: root.asking == PowerChoice.restart ? "Restart the Kindle?" : "Power off the Kindle?";
            font-size: 21px;
            font-weight: 600;
            color: Theme.ink;
            vertical-alignment: center;
        }
        Button {
            text: "Cancel";
            kind: ButtonKind.quiet;
            clicked => { root.asking = PowerChoice.none; }
        }
        Button {
            text: root.asking == PowerChoice.restart ? "Restart" : "Power off";
            kind: ButtonKind.primary;
            clicked => {
                if root.asking == PowerChoice.restart {
                    Kindil.restart();
                } else {
                    Kindil.power-off();
                }
                root.asking = PowerChoice.none;
            }
        }
    }
}

/// Covers the app while the device sleeps, is a USB drive, or is off. E-ink
/// keeps the image without power, so this is what the Kindle shows meanwhile.
component SystemScreen inherits Rectangle {
    background: Theme.paper;
    // The app underneath must not take taps.
    TouchArea { }
    VerticalLayout {
        alignment: center;
        padding-left: 64px;
        padding-right: 64px;
        spacing: 20px;
        HorizontalLayout {
            alignment: center;
            Image {
                source: @image-url("../assets/logo.svg");
                width: 200px;
                height: 200px;
            }
        }
        Text {
            text: "قنديل";
            font-size: 96px;
            font-weight: 700;
            color: Theme.ink;
            horizontal-alignment: center;
        }
        Text {
            text: Kindil.system == System.asleep ? (Kindil.battery-empty ? "Battery low" : "Asleep")
                : Kindil.system == System.usb-drive ? "USB drive" : "Off";
            font-size: 44px;
            font-weight: 600;
            color: Theme.ink;
            horizontal-alignment: center;
        }
        Text {
            text: Kindil.system == System.asleep
                    ? (Kindil.battery-empty ? "Plug in the cable to charge, then press the power button." : "Press the power button to wake.")
                : Kindil.system == System.usb-drive
                    ? "Your books are on the computer as a drive named Kindle. Eject it there, then unplug the cable."
                    : "Hold the power button for a few seconds to start.";
            font-size: 24px;
            color: Theme.ink-2;
            wrap: word-wrap;
            horizontal-alignment: center;
        }
        if Kindil.system == System.asleep: Text {
            text: "Battery " + Kindil.battery-label;
            font-size: 22px;
            color: Theme.ink-3;
            horizontal-alignment: center;
        }
    }
}

/// A page's title with a back arrow to the page it came from.
component SubHeader {
    in property <string> title;
    in property <Page> back: Page.settings;
    height: 96px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: Theme.gutter;
        padding-top: 16px;
        spacing: 4px;
        Button {
            text: "‹";
            kind: ButtonKind.quiet;
            font-size: 40px;
            clicked => { Kindil.go(root.back); }
        }
        Text {
            text: root.title;
            font-size: 40px;
            font-weight: 700;
            color: Theme.ink;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        @children
    }
}

/// One Settings section: a page with a back arrow, scrolling only if it must.
component SectionPage {
    in property <string> title;
    VerticalLayout {
        SubHeader { title: root.title; }
        SwipeScroll {
            vertical-stretch: 1;
            content-height: content.preferred-height;
            content := VerticalLayout {
                width: parent.width;
                alignment: start;
                padding-left: Theme.gutter;
                padding-right: Theme.gutter;
                padding-bottom: 32px;
                @children
            }
        }
    }
}

/// A row of the Settings index: the section and what it is set to now.
component SectionRow {
    in property <string> title;
    in property <string> summary;
    in property <Page> target;
    min-height: 100px;
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: 4px;
            Text { text: root.title; font-size: 25px; font-weight: 600; color: Theme.ink; }
            Text { text: root.summary; font-size: 19px; color: Theme.ink-2; overflow: elide; }
        }
        Text { text: "›"; font-size: 34px; color: Theme.ink-2; vertical-alignment: center; }
    }
    TouchArea { clicked => { Kindil.go(root.target); } }
}

/// Settings is an index of sections, each its own page: a page swap is one
/// e-ink refresh, while scrolling a long list redraws on every move.
component SettingsPage {
    pure function said(state: Switch) -> string {
        state == Switch.on ? "on" : state == Switch.off ? "off" : "not installed"
    }
    VerticalLayout {
        PageHeader { title: "Settings"; trailing: Kindil.version; }
        VerticalLayout {
            vertical-stretch: 1;
            alignment: start;
            padding-left: Theme.gutter;
            padding-right: Theme.gutter;
            SectionRow {
                title: "Display";
                summary: (Kindil.dashboard == DashboardKind.miqat ? "Prayer times" : "Clock")
                    + (Kindil.brightness >= 0 ? " · light " + Kindil.brightness + "%" : "");
                target: Page.display;
            }
            Divider { }
            SectionRow { title: "Wi-Fi"; summary: Kindil.wifi-detail; target: Page.wifi; }
            Divider { }
            SectionRow {
                title: "Remote access";
                summary: "SSH " + root.said(Kindil.ssh) + " · Syncthing " + root.said(Kindil.sync);
                target: Page.remote;
            }
            Divider { }
            SectionRow {
                title: "Power";
                summary: "Sleep when idle: " + Kindil.sleep-choices[Kindil.auto-sleep];
                target: Page.power;
            }
            Divider { }
            SectionRow { title: "Updates"; summary: Kindil.update-status; target: Page.updates; }
            Divider { }
            SectionRow { title: "About"; summary: "Battery " + Kindil.battery-label; target: Page.about; }
        }
    }
}

component DisplaySettings inherits SectionPage {
    title: "Display";
    Group {
        title: "HOME SCREEN";
        Rectangle {
            height: 72px;
            border-radius: Theme.radius;
            border-width: 2px;
            border-color: Theme.ink;
            HorizontalLayout {
                padding: 6px;
                spacing: 6px;
                Segment {
                    text: "Prayer times";
                    selected: Kindil.dashboard == DashboardKind.miqat;
                    clicked => { Kindil.choose-dashboard(DashboardKind.miqat); }
                }
                Segment {
                    text: "Clock";
                    selected: Kindil.dashboard == DashboardKind.clock;
                    clicked => { Kindil.choose-dashboard(DashboardKind.clock); }
                }
            }
        }
    }
    Group {
        title: "SCREEN";
        LightRow { }
        Divider { }
        HorizontalLayout {
            min-height: 84px;
            spacing: 16px;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { text: "Clean screen"; font-size: 23px; font-weight: 600; color: Theme.ink; }
                Text { text: "Flash once to clear ghosting"; font-size: 18px; color: Theme.ink-2; }
            }
            VerticalLayout {
                alignment: center;
                Button { text: "Refresh"; clicked => { Kindil.clean-screen(); } }
            }
        }
    }
}

component WifiSettings inherits SectionPage {
    title: "Wi-Fi";
    Group {
        SwitchRow {
            title: "Wi-Fi";
            detail: Kindil.wifi-detail;
            state: Kindil.wifi;
            toggled => { Kindil.toggle-wifi(); }
        }
        Divider { }
        Rectangle {
            min-height: 76px;
            HorizontalLayout {
                Text {
                    text: "Choose a network";
                    font-size: 23px;
                    font-weight: 600;
                    color: Kindil.wifi == Switch.on ? Theme.ink : Theme.ink-3;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text { text: "›"; font-size: 34px; color: Theme.ink-2; vertical-alignment: center; }
            }
            TouchArea {
                enabled: Kindil.wifi == Switch.on;
                clicked => {
                    Kindil.go(Page.networks);
                    Kindil.scan-networks();
                }
            }
        }
    }
}

component RemoteSettings inherits SectionPage {
    title: "Remote access";
    Group {
        SwitchRow {
            title: "SSH server";
            detail: Kindil.ssh-detail;
            state: Kindil.ssh;
            toggled => { Kindil.toggle-ssh(); }
        }
        Divider { }
        SwitchRow {
            title: "Start SSH at boot";
            state: Kindil.ssh-at-boot;
            toggled => { Kindil.toggle-ssh-at-boot(); }
        }
        Divider { }
        SwitchRow {
            title: "Syncthing";
            detail: Kindil.sync-detail;
            state: Kindil.sync;
            toggled => { Kindil.toggle-sync(); }
        }
    }
}

component PowerSettings inherits SectionPage {
    title: "Power";
    Group {
        title: "SLEEP WHEN IDLE";
        Rectangle {
            height: 72px;
            border-radius: Theme.radius;
            border-width: 2px;
            border-color: Theme.ink;
            HorizontalLayout {
                padding: 6px;
                spacing: 4px;
                for choice[i] in Kindil.sleep-choices: Segment {
                    text: choice;
                    selected: i == Kindil.auto-sleep;
                    clicked => { Kindil.choose-auto-sleep(i); }
                }
            }
        }
        Text {
            text: "Doze keeps the dashboard updating on little battery: after 2 minutes without a touch the light goes off and the Kindle sleeps between minute updates. Press the power button to use it. Never keeps it fully awake.";
            font-size: 17px;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
    }
    Group {
        title: "STARTUP";
        SwitchRow {
            title: "Start kindil at boot";
            detail: Kindil.boot-start-detail;
            state: Kindil.boot-start;
            toggled => { Kindil.toggle-boot-start(); }
        }
    }
Rectangle { height: 20px; }
    Button {
        text: "Exit to Kindle";
        clicked => { Kindil.exit-app(); }
    }
    Text {
        text: "Returns to Amazon's home screen. kindil never changes the system.";
        font-size: 17px;
        color: Theme.ink-3;
        wrap: word-wrap;
        horizontal-alignment: center;
    }
    Rectangle { height: 12px; }
    PowerButtons { }
}

component UpdateSettings inherits SectionPage {
    title: "Updates";
    Group {
        HorizontalLayout {
            min-height: 84px;
            spacing: 16px;
            Text {
                text: Kindil.update-status;
                font-size: 20px;
                color: Theme.ink;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: Kindil.update-button;
                    enabled: Kindil.update-enabled;
                    clicked => { Kindil.update(); }
                }
            }
        }
        Text {
            text: "Signed releases from GitHub. A new version that fails in its first two minutes is replaced by the previous one.";
            font-size: 17px;
            color: Theme.ink-3;
            wrap: word-wrap;
        }
    }
}

component AboutSettings inherits SectionPage {
    title: "About";
    Group {
        for fact in Kindil.facts: HorizontalLayout {
            min-height: 52px;
            Text {
                text: fact.label;
                font-size: 20px;
                color: Theme.ink-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: fact.value;
                font-size: 20px;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
            }
        }
    }
    if Kindil.doze-draw != "": Group {
        title: "BATTERY WHILE DOZING";
        HorizontalLayout {
            min-height: 52px;
            Text {
                text: "Measured draw";
                font-size: 20px;
                color: Theme.ink-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: Kindil.doze-draw;
                font-size: 20px;
                font-weight: 600;
                color: Theme.ink;
                vertical-alignment: center;
            }
        }
    }
}

component NetworksPage {
    VerticalLayout {
        SubHeader {
            title: "Networks";
            back: Page.wifi;
            VerticalLayout {
                alignment: center;
                Button {
                    text: Kindil.network-busy ? "Scanning…" : "Scan";
                    enabled: !Kindil.network-busy;
                    clicked => { Kindil.scan-networks(); }
                }
            }
        }
        Text {
            x: Theme.gutter;
            text: Kindil.network-status;
            font-size: 18px;
            color: Theme.ink-2;
            height: 32px;
            vertical-alignment: center;
        }
        SwipeScroll {
            vertical-stretch: 1;
            content-height: rows.preferred-height;
            rows := VerticalLayout {
                width: parent.width;
                alignment: start;
                for network in Kindil.networks: Rectangle {
                    height: 88px;
                    TouchArea {
                        clicked => {
                            Kindil.join-ssid = network.ssid;
                            Kindil.join-open = true;
                        }
                    }
                    HorizontalLayout {
                        padding-left: Theme.gutter;
                        padding-right: Theme.gutter;
                        spacing: 16px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text { text: network.ssid; font-size: 23px; font-weight: 600; color: Theme.ink; overflow: elide; }
                            Text { text: network.detail; font-size: 18px; color: Theme.ink-2; }
                        }
                        VerticalLayout {
                            alignment: center;
                            WifiBars { bars: network.bars; }
                        }
                    }
                    Divider {
                        x: Theme.gutter;
                        y: parent.height - 1px;
                        width: parent.width - 2 * Theme.gutter;
                    }
                }
                Rectangle {
                    height: 88px;
                    TouchArea {
                        clicked => {
                            Kindil.join-ssid = "";
                            Kindil.join-open = true;
                        }
                    }
                    Text {
                        x: Theme.gutter;
                        text: "Other network…";
                        font-size: 23px;
                        font-weight: 600;
                        color: Theme.ink-2;
                    }
                }
            }
        }
    }
}

component JoinSheet inherits Sheet {
    Caption { text: "JOIN NETWORK"; }
    ssid := TextField {
        text <=> Kindil.join-ssid;
        placeholder: "Network name";
        accepted => { password.focus(); }
    }
    password := TextField {
        input-type: InputType.password;
        placeholder: "Password (empty for open networks)";
        accepted => { sink.focus(); }
    }
    HorizontalLayout {
        spacing: 12px;
        Button {
            text: "Cancel";
            horizontal-stretch: 1;
            clicked => {
                password.text = "";
                Kindil.join-open = false;
                sink.focus();
            }
        }
        Button {
            text: "Join";
            kind: ButtonKind.primary;
            enabled: Kindil.join-ssid != "" && !Kindil.network-busy;
            horizontal-stretch: 1;
            clicked => {
                Kindil.join-network(Kindil.join-ssid, password.text);
                // Never keep a passphrase in the UI longer than the request.
                password.text = "";
                Kindil.join-open = false;
                sink.focus();
            }
        }
    }
    sink := FocusScope { height: 0px; }
}

// ───────────────────────── window ─────────────────────────

export component AppWindow inherits Window {
    title: "kindil · قنديل";
    width: 758px;
    height: 1024px;
    background: Theme.paper;
    default-font-family: "IBM Plex Sans Arabic";
    default-font-size: 22px;

    out property <bool> keyboard-visible: TextInputInterface.text-input-focused;
    callback dismiss-keyboard();
    dismiss-keyboard => { focus-sink.focus(); }

    property <bool> immersive: Kindil.page == Page.dashboard && Kindil.dashboard == DashboardKind.miqat;
    property <length> usable-height: root.height - (root.keyboard-visible ? keyboard.height : 0px);

    // Full-bleed and pixel-exact: Miqat renders for this exact panel.
    if root.immersive: Rectangle {
        Image {
            source: Kindil.miqat-frame;
            width: 100%;
            height: 100%;
            image-fit: contain;
        }
        if Kindil.miqat-frame.width == 0: Text {
            x: 48px;
            width: parent.width - 96px;
            text: Kindil.miqat-error;
            font-size: 24px;
            color: Theme.ink;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // The bars and the panel come and go together.
        TouchArea {
            clicked => {
                Kindil.chrome-visible = !Kindil.chrome-visible;
                Kindil.panel-open = Kindil.chrome-visible;
            }
        }
    }

    // The dashboard has no bars until tapped, so the battery stays visible in
    // the one empty strip of Miqat's frame, between the clock and the prayer name.
    if root.immersive && !Kindil.chrome-visible: Rectangle {
        x: (parent.width - self.width) / 2;
        y: 8px;
        width: 140px;
        height: 36px;
        background: Theme.paper;
        BatteryStatus { }
    }

    VerticalLayout {
        height: root.usable-height;
        if !root.immersive || Kindil.chrome-visible: StatusRow { }
        Rectangle {
            vertical-stretch: 1;
            if Kindil.page == Page.dashboard && Kindil.dashboard == DashboardKind.clock: ClockPage { width: parent.width; height: parent.height; }
            if Kindil.page == Page.library: LibraryPage { width: parent.width; height: parent.height; }
            if Kindil.page == Page.reader: ReaderPage { width: parent.width; height: parent.height; }
            if Kindil.page == Page.settings: SettingsPage { width: parent.width; height: parent.height; }
            if Kindil.page == Page.display: DisplaySettings { width: parent.width; height: parent.height; }
            if Kindil.page == Page.wifi: WifiSettings { width: parent.width; height: parent.height; }
            if Kindil.page == Page.remote: RemoteSettings { width: parent.width; height: parent.height; }
            if Kindil.page == Page.power: PowerSettings { width: parent.width; height: parent.height; }
            if Kindil.page == Page.updates: UpdateSettings { width: parent.width; height: parent.height; }
            if Kindil.page == Page.about: AboutSettings { width: parent.width; height: parent.height; }
            if Kindil.page == Page.networks: NetworksPage { width: parent.width; height: parent.height; }
        }
        if !root.immersive || Kindil.chrome-visible: TabBar { }
    }

    // A tap outside the panel puts it away (and the bars with it, on the dashboard).
    if Kindil.panel-open: TouchArea {
        y: 56px;
        height: root.usable-height - 56px - 92px;
        clicked => {
            Kindil.panel-open = false;
            if root.immersive {
                Kindil.chrome-visible = false;
            }
        }
    }
    if Kindil.panel-open: QuickPanel {
        y: 56px;
    }

    // Hide the revealed bars and the panel again so the wall dashboard stays
    // clean. Using a panel control starts the time over.
    property <int> activity: Kindil.activity;
    changed activity => { hide.restart(); }
    hide := Timer {
        interval: 20s;
        running: Kindil.chrome-visible || Kindil.panel-open;
        triggered => {
            Kindil.chrome-visible = false;
            Kindil.panel-open = false;
        }
    }

    Timer {
        interval: 8s;
        running: Kindil.notice != "";
        triggered => {
            Kindil.notice = "";
            Kindil.notice-undo = false;
        }
    }

    if Kindil.notice != "": Notice {
        x: 16px;
        width: parent.width - 32px;
        y: root.usable-height - 92px - self.height - 12px;
    }

    if Kindil.page == Page.library && Kindil.selected-book >= 0: BookActions {
        y: root.usable-height - self.height;
        height: self.preferred-height;
    }
    if Kindil.page == Page.networks && Kindil.join-open: JoinSheet {
        y: root.usable-height - self.height;
        height: self.preferred-height;
    }

    focus-sink := FocusScope { width: 0px; height: 0px; }
    keyboard := VirtualKeyboard {
        visible: root.keyboard-visible;
        y: root.height - self.height;
        height: 320px;
        close => { root.dismiss-keyboard(); }
    }

    if Kindil.system != System.app: SystemScreen { }
}
