import { Button, LineEdit, ScrollView, VerticalBox, Slider } from "std-widgets.slint";
import "../assets/DejaVuSans.ttf";

export component AppWindow inherits Window {
    title: "kindil · قنديل";
    width: 758px;
    height: 1024px;
    background: white;
    default-font-family: "DejaVu Sans";
    default-font-size: 22px;
    in-out property <int> page: 0;
    in-out property <string> brand: "kindil · قنديل";
    in property <string> clock;
    in property <string> date;
    in property <string> status;
    in property <string> settings;
    in-out property <int> dashboard-mode: 0;
    in property <image> miqat-frame;
    in property <string> miqat-error: "Miqat configuration required. Tap the top-right corner for controls.";
    in property <[string]> books;
    in property <[string]> networks;
    in property <string> network-status: "Not connected";
    in-out property <string> ssid;
    in property <string> book-title;
    in property <string> book-text;
    in property <string> book-page;
    in property <string> wifi-state: "not monitored";
    in property <string> ssh-state: "not managed";
    in property <string> sync-state: "not managed";
    in property <string> service-status: "⌁ " + root.wifi-state + "   >_ SSH: " + root.ssh-state + "   ↻ Sync: " + root.sync-state;
    in-out property <int> selected-file: -1;
    in-out property <string> new-filename;
    in-out property <bool> confirm-trash: false;
    in property <string> file-status;
    in property <bool> can-undo-trash: false;
    callback rename-file(int, string);
    callback trash-file(int);
    callback undo-trash();
    in-out property <float> reading-font-size: 22;
    in-out property <float> brightness: 50;
    in property <bool> brightness-enabled: true;
    in property <string> brightness-status: "Simulated frontlight — preview only";
    in-out property <bool> controls-open: false;
    callback font-size-changed(float);
    callback brightness-changed(float);
    callback open-book(int);
    callback turn-page(bool);
    callback scan-wifi();
    callback connect-wifi(string, string);

    if root.page == 0 && root.dashboard-mode == 0: Rectangle {
        Image { source: root.miqat-frame; width: 100%; height: 100%; image-fit: contain; }
        if root.miqat-frame.width == 0: Text {text: root.miqat-error; color: black; wrap: word-wrap; width: parent.width - 56px; x: 28px; y: 200px;}
        TouchArea { x: parent.width - 100px; width: 100px; height: 90px;
            clicked => {root.page = 4; root.controls-open = true;} }
    }
    VerticalLayout {
        visible: root.page != 0 || root.dashboard-mode != 0;
        padding: 28px;
        spacing: 18px;
        HorizontalLayout {
            Text { text: root.brand; color: black; font-size: 26px; }
            Text { text: root.status; color: black; font-size: 17px; horizontal-alignment: right; }
            Button { text: "Aa / ☀"; clicked => {root.controls-open = !root.controls-open;} }
        }
        if root.controls-open: VerticalLayout {
            Text { text: "Reading font: " + round(root.reading-font-size) + " px"; color: black; }
            Slider { minimum: 16; maximum: 40; value <=> root.reading-font-size;
                changed(value) => {root.font-size-changed(round(value));} }
            Text { text: "Brightness: " + round(root.brightness) + "%"; color: black; }
            Slider { minimum: 0; maximum: 100; enabled: root.brightness-enabled; value <=> root.brightness;
                changed(value) => {root.brightness-changed(round(value));} }
            Text { text: root.brightness-status; color: black; font-size: 16px; wrap: word-wrap; }
        }
        Rectangle { height: 2px; background: black; }
        Text { text: root.service-status; color: black; font-size: 15px; }
        if root.page == 0: VerticalLayout {
            spacing: 22px;
            Text { text: root.clock; font-size: 94px; color: black; horizontal-alignment: center; }
            Text { text: root.date; color: black; horizontal-alignment: center; }
            Rectangle { height: 2px; background: black; }
        }
        if root.page == 1: VerticalLayout {
            Text { text: "Library — EPUB / text"; font-size: 30px; color: black; }
            ScrollView { VerticalBox {
                for title[index] in root.books: HorizontalLayout {
                    Button { text: title; clicked => { root.open-book(index); } }
                    Button { text: "⋮"; clicked => {root.selected-file = index; root.new-filename = title; root.confirm-trash = false;} }
                }
            } }
            if root.selected-file >= 0: VerticalLayout {
                LineEdit { text <=> root.new-filename; }
                HorizontalLayout {
                    Button { text: "Rename"; clicked => { root.rename-file(root.selected-file, root.new-filename); } }
                    Button { text: root.confirm-trash ? "Confirm move to Trash" : "Move to Trash"; clicked => {
                        if root.confirm-trash {root.trash-file(root.selected-file); root.confirm-trash = false;} else {root.confirm-trash = true;}
                    } }
                }
            }
            Text { text: root.file-status; color: black; font-size: 17px; wrap: word-wrap; }
            Button { text: "Undo last Trash"; enabled: root.can-undo-trash; clicked => {root.undo-trash();} }
        }
        if root.page == 2: VerticalLayout {
            Text { text: root.book-title; font-size: 28px; color: black; overflow: elide; }
            ScrollView { Text { width: root.width - 80px; text: root.book-text; color: black; font-size: root.reading-font-size * 1px; wrap: word-wrap; } }
            HorizontalLayout {
                Button { text: "Previous"; clicked => { root.turn-page(false); } }
                Text { text: root.book-page; color: black; horizontal-alignment: center; }
                Button { text: "Next"; clicked => { root.turn-page(true); } }
            }
        }
        if root.page == 3: VerticalLayout {
            Text { text: "Wi-Fi"; color: black; font-size: 30px; }
            Text { text: root.network-status; color: black; wrap: word-wrap; }
            Button { text: "Search networks"; clicked => { root.scan-wifi(); } }
            ScrollView { VerticalBox {
                for network in root.networks: Button { text: network; clicked => { root.ssid = network; } }
            } }
            LineEdit { text <=> root.ssid; placeholder-text: "Network name"; }
            password := LineEdit { input-type: InputType.password; placeholder-text: "WPA2 passphrase"; }
            Button { text: "Connect"; clicked => {
                root.connect-wifi(root.ssid, password.text);
                password.text = "";
            } }
        }
        if root.page == 4: VerticalLayout {
            HorizontalLayout {
                Button { text: "Miqat dashboard"; clicked => {root.dashboard-mode = 0; root.page = 0;} }
                Button { text: "Clock dashboard"; clicked => {root.dashboard-mode = 1; root.page = 0;} }
            }
            Text { text: "Settings & diagnostics"; color: black; font-size: 30px; }
            Text { text: root.settings; color: black; wrap: word-wrap; vertical-stretch: 1; }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            Button { text: "Dashboard"; clicked => { root.page = 0; } }
            Button { text: "Library"; clicked => { root.page = 1; } }
            Button { text: "Wi-Fi"; clicked => { root.page = 3; } }
            Button { text: "Settings"; clicked => { root.page = 4; } }
        }
    }
}
